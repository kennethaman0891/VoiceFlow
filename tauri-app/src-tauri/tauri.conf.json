{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "VoiceFlow",
  "version": "0.1.0",
  "identifier": "com.kennethaman.voiceflow",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "withGlobalTauri": true,
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "main",
        "title": "VoiceFlow",
        "width": 420,
        "height": 560,
        "minWidth": 380,
        "minHeight": 480,
        "resizable": true,
        "fullscreen": false,
        "transparent": false,
        "decorations": true,
        "center": true,
        "shadow": true
      },
      {
        "label": "mini",
        "title": "",
        "width": 64,
        "height": 64,
        "resizable": false,
        "transparent": true,
        "decorations": false,
        "alwaysOnTop": true,
        "visible": false,
        "skipTaskbar": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "resources": [
      "models/ggml-base.bin"
    ],
    "targets": [
      "app",
      "msi",
      "nsis",
      "appimage"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "10.15",
      "infoPlist": "Info.plist"
    },
    "windows": {
      "certificateThumbprint": null,
      "digestAlgorithm": "sha256",
      "timestampUrl": "http://timestamp.digicert.com",
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      }
    },
    "linux": {
      "deb": {
        "depends": ["libssl3", "libasound2", "libglib2.0-0"]
      },
      "appimage": {
        "bundleMediaFramework": true
      }
    }
  }
}
